# ─────────────────────────────────────────────────────────────
# MuzikHub environment template.
#   cp .env.example apps/api/.env   then fill in real values.
# Never commit .env files (they are git-ignored).
# Only variables prefixed with VITE_ reach the browser —
# NEVER put a secret in a VITE_ variable.
# ─────────────────────────────────────────────────────────────

# ── API server (apps/api/.env) ──
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to call the API with cookies. Production refuses http:,
# localhost and trailing slashes (setup B: https://<project>.vercel.app).
CORS_ORIGINS=http://localhost:5173
# Setup B only (Vercel forwards /api to Render): the shared secret Vercel adds to every forwarded
# request. Same value in Vercel and Render, never in a VITE_ variable. Generate: openssl rand -hex 32
# When set, requests that bypass Vercel get 403 (except /api/v1/health). Leave unset locally.
# PROXY_SHARED_SECRET=

# PostgreSQL — matches docker-compose.yml defaults (local dev only)
DATABASE_URL=postgresql://muzikhub:muzikhub_dev_password@localhost:5435/muzikhub?schema=public
# Connections in the API's pool (default 5; Supabase's Free session pooler allows only a few).
# DATABASE_POOL_MAX=5
#
# Supabase (Session pooler, port 5432). Put the real value in apps/api/.env.supabase (git-ignored),
# never in this file. Any non-localhost DATABASE_URL MUST use sslmode=verify-full and an existing
# sslrootcert, or the API refuses to start. Relative certificate paths are resolved against apps/api.
# Percent-encode special characters in the password (@ → %40, : → %3A, / → %2F, # → %23, % → %25).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs/prod-supabase.crt
# Check it, read-only:  npm run db:check -w @muzikhub/api

# Better Auth
# Generate a strong secret with:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the API (Better Auth is served at <this>/api/auth/*)
BETTER_AUTH_URL=http://localhost:4000

# Public URL of the web app (links in emails)
WEB_APP_URL=http://localhost:5173

# Email — Resend (server-side only; never in a VITE_ variable).
# EMAIL_TRANSPORT: capture (tests) | console (dev default: printed, not sent) | resend (production default)
#                  | disabled (restricted-email mode: no email at all; password reset and email
#                    confirmation are switched off and the app says so. See docs/ARCHITECTURE.md §5d)
# EMAIL_TRANSPORT=console
# Production refuses EMAIL_TRANSPORT=disabled unless this is true (a deliberate choice: no password
# recovery). Not allowed together with REQUIRE_EMAIL_VERIFICATION=true.
# ALLOW_EMAIL_DISABLED_IN_PRODUCTION=false
RESEND_API_KEY=
# Sender on a domain VERIFIED in Resend (none yet), e.g. "MuzikHub <no-reply@mail.example.com>".
# Production refuses to start without RESEND_API_KEY and EMAIL_FROM.
EMAIL_FROM=

# Require a verified email before publishing (and, later, messaging and calls). Keep "false"
# until a Resend sending domain is verified, otherwise real users can't receive the link.
REQUIRE_EMAIL_VERIFICATION=false

# Cloudinary — media storage (server-side only; the secret never reaches the browser).
# Dashboard → Settings → API Keys. The API KEY is the 15-digit number; the SECRET is the long string.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Assets are stored under <folder>/<NODE_ENV>/<userId>/<assetId>
CLOUDINARY_FOLDER=muzikhub

# Payments (ADR 0004). off (default) | sandbox | live.
#   sandbox → test payments only; orders marked SANDBOX and excluded from revenue forever.
#   live    → refused until the owner approves (config/payments-approval.ts) — not reachable today.
PAYMENTS_MODE=off
# fake (the labelled TEST PROVIDER; default outside production, refused in production) | notchpay
# PAYMENTS_PROVIDER=fake
# Production refuses PAYMENTS_MODE=sandbox unless this is true (a staging deployment only), because
# sandbox orders grant real benefits for fake money.
# PAYMENTS_ALLOW_SANDBOX_IN_PRODUCTION=false

# Notch Pay — server-side only, never in apps/web. The adapter is a fail-closed stub for now
# (externally blocked) and reads none of these. Keys come from your Notch Pay business dashboard.
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_PRIVATE_KEY=
NOTCHPAY_WEBHOOK_SECRET=

# ── Web app (apps/web/.env) — optional ──
# Leave unset in development: Vite proxies /api to the API server.
# VITE_API_URL=http://localhost:4000
# Production origin of the web app (not a secret). Enables the canonical URL on the landing page
# and generates sitemap.xml (robots.txt is always generated). Not decided yet — leave unset.
# VITE_SITE_URL=https://<your-production-domain>
