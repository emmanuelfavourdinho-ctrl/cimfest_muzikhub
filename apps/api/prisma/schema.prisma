// MuzikHub database schema.
// The connection URL is configured in prisma.config.ts (from DATABASE_URL).
// Enum values must match the keys in packages/shared/src/taxonomy.ts and links.ts.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Identity — tables required by Better Auth, plus MuzikHub fields.
// ─────────────────────────────────────────────────────────────

enum PrimaryUse {
  CREATOR
  FAN
  PROFESSIONAL
}

/// Global platform role. Community roles are separate and scoped (CLAUDE.md §19.1).
enum PlatformRole {
  USER
  MODERATOR
  ADMIN
}

/// Approved 2026-11-24. Enforced on the server (see lib/account-status.ts).
enum AccountStatus {
  ACTIVE
  /// Can sign in and browse; cannot publish, interact, message or collaborate.
  RESTRICTED
  /// Temporary: mandatory reason and expiry (statusUntil). Cannot sign in until it expires.
  SUSPENDED
  /// Indefinite. Only an administrator can reinstate.
  BANNED
  DEACTIVATED
}

model User {
  id                      String                   @id
  name                    String
  email                   String                   @unique
  emailVerified           Boolean                  @default(false)
  image                   String?
  /// Lower-case, unique handle used in profile URLs (Better Auth username plugin).
  username                String?                  @unique
  /// Username as the user typed it (original capitalisation).
  displayUsername         String?
  primaryUse              PrimaryUse?
  /// Server-controlled. Never accepted from client input.
  platformRole            PlatformRole             @default(USER)
  /// Server-controlled. See AccountStatus.
  status                  AccountStatus            @default(ACTIVE)
  /// Reason shown to the user for RESTRICTED / SUSPENDED / BANNED.
  statusReason            String?
  /// When a SUSPENDED account is automatically reinstated.
  statusUntil             DateTime?
  statusChangedAt         DateTime?
  /// Better Auth two-factor plugin. Required for MODERATOR and ADMIN.
  twoFactorEnabled        Boolean                  @default(false)
  twoFactors              TwoFactor[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  sessions                Session[]
  accounts                Account[]
  profile                 Profile?
  mediaAssets             MediaAsset[]
  portfolioItems          PortfolioItem[]
  posts                   Post[]
  postLikes               PostLike[]
  comments                Comment[]
  reports                 Report[]
  /// People this user follows / people following this user.
  following               Follow[]                 @relation("Follower")
  followers               Follow[]                 @relation("Following")
  sentConnections         Connection[]             @relation("ConnectionRequester")
  receivedConnections     Connection[]             @relation("ConnectionAddressee")
  /// Organiser capability (D7): granted only by an ADMIN; also needs a verified email and
  /// the PROFESSIONAL primary use. Server-controlled.
  isOrganiser             Boolean                  @default(false)
  organiserSince          DateTime?
  opportunities           Opportunity[]            @relation("OpportunityOrganiser")
  opportunityApplications OpportunityApplication[]
  subscriptions           Subscription[]
  promotions              Promotion[]
  orders                  Order[]
  notifications           Notification[]
  blocksMade              UserBlock[]              @relation("BlocksMade")
  blocksReceived          UserBlock[]              @relation("BlocksReceived")
  notificationSettings    NotificationSetting[]
  analyticsDaily          AnalyticsDaily[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// Better Auth two-factor plugin. Secret and backup codes are encrypted by Better Auth.
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────────────────────────
// Professional profiles
// ─────────────────────────────────────────────────────────────

enum CreativeRole {
  ARTIST
  SINGER
  RAPPER
  SONGWRITER
  PRODUCER
  BEATMAKER
  DJ
  AUDIO_ENGINEER
  RECORDING_ENGINEER
  MIXING_MASTERING_ENGINEER
  COMPOSER
  INSTRUMENTALIST
  DANCER
  MANAGER
  RECORD_LABEL
  PROMOTER
  EVENT_ORGANIZER
  MARKETER
  TALENT_SCOUT
  OTHER
}

enum CareerStage {
  EMERGING
  DEVELOPING
  ESTABLISHED
}

enum LinkPlatform {
  SPOTIFY
  APPLE_MUSIC
  YOUTUBE
  SOUNDCLOUD
  AUDIOMACK
  BOOMPLAY
  DEEZER
  BANDCAMP
  INSTAGRAM
  TIKTOK
  FACEBOOK
  X
  LINKEDIN
  WEBSITE
}

/// One per user, created together with the account.
model Profile {
  userId                String         @id
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                   String?
  location              String?
  /// A person can hold several professional identities (CLAUDE.md §4).
  roles                 CreativeRole[]
  /// Keys from GENRES in packages/shared (validated by the API).
  genres                String[]
  skills                String[]
  /// Keys from GOALS in packages/shared.
  goals                 String[]
  careerStage           CareerStage?
  /// Verified images (MediaAsset). Unique: an asset can fill only one slot.
  avatarAssetId         String?        @unique
  avatarAsset           MediaAsset?    @relation("ProfileAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  coverAssetId          String?        @unique
  coverAsset            MediaAsset?    @relation("ProfileCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  /// Furthest onboarding step reached, so setup resumes where it stopped.
  onboardingStep        Int            @default(0)
  onboardingCompletedAt DateTime?
  links                 ProfileLink[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  /// Paid benefit (Creator Plus / Pro). Shown only while the owner is entitled (checked at read time).
  accent                ProfileAccent?

  // GIN indexes make "has any of these roles/genres" filters fast for discovery.
  @@index([roles], type: Gin)
  @@index([genres], type: Gin)
  @@map("profile")
}

model ProfileLink {
  id        String       @id @default(cuid())
  profileId String
  profile   Profile      @relation(fields: [profileId], references: [userId], onDelete: Cascade)
  /// Derived from the URL's hostname on the server — never taken from the client.
  platform  LinkPlatform
  url       String
  position  Int

  @@unique([profileId, url])
  @@index([profileId, position])
  @@map("profile_link")
}

// ─────────────────────────────────────────────────────────────
// Media (Cloudinary). The file lives in Cloudinary; this row is our
// record of who owns it, what it is, and whether it has been verified.
// ─────────────────────────────────────────────────────────────

enum MediaKind {
  IMAGE
  AUDIO
  VIDEO
}

enum MediaPurpose {
  AVATAR
  COVER
  PORTFOLIO
  POST
  COMMUNITY
  COMPETITION
}

enum MediaStatus {
  /// Signature issued; the browser may be uploading. Not usable yet.
  PENDING
  /// Verified against Cloudinary (size, format, duration). Usable.
  READY
  /// Removal requested; a Cloudinary delete is pending or will be retried by cleanup.
  DELETING
}

model MediaAsset {
  id               String       @id @default(cuid())
  ownerId          String
  owner            User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind             MediaKind
  purpose          MediaPurpose
  status           MediaStatus  @default(PENDING)
  /// Cloudinary public_id, generated by the server: <folder>/<env>/<ownerId>/<id>
  publicId         String       @unique
  format           String?
  bytes            Int?
  width            Int?
  height           Int?
  durationSec      Float?
  /// Cloudinary version, used in delivery URLs for cache busting.
  version          Int?
  originalFilename String?
  createdAt        DateTime     @default(now())
  readyAt          DateTime?

  profileAvatar  Profile?       @relation("ProfileAvatar")
  profileCover   Profile?       @relation("ProfileCover")
  portfolioMedia PortfolioItem? @relation("PortfolioMedia")
  portfolioCover PortfolioItem? @relation("PortfolioCover")
  postMedia      PostMedia?

  @@index([ownerId, status])
  @@index([status, createdAt])
  @@map("media_asset")
}

// ─────────────────────────────────────────────────────────────
// Portfolios
// ─────────────────────────────────────────────────────────────

enum PortfolioType {
  AUDIO
  BEAT
  VIDEO
  IMAGE
  PROJECT
}

enum PortfolioStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Approved 2026-11-23: public or private only.
enum Visibility {
  PUBLIC
  PRIVATE
}

model PortfolioItem {
  id               String          @id @default(cuid())
  ownerId          String
  owner            User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type             PortfolioType
  title            String
  description      String?
  /// Keys from GENRES in packages/shared.
  genres           String[]
  /// Free-text credits, e.g. "Produced by …, mixed by …".
  credits          String?
  /// Optional https link (YouTube, SoundCloud, Spotify…); platform derived server-side.
  externalUrl      String?
  externalPlatform LinkPlatform?
  mediaAssetId     String?         @unique
  mediaAsset       MediaAsset?     @relation("PortfolioMedia", fields: [mediaAssetId], references: [id], onDelete: SetNull)
  coverAssetId     String?         @unique
  coverAsset       MediaAsset?     @relation("PortfolioCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  status           PortfolioStatus @default(DRAFT)
  visibility       Visibility      @default(PUBLIC)
  featured         Boolean         @default(false)
  publishedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  /// Feed showcase posts pointing at this item (deleted with it).
  posts            Post[]
  /// Moderation removal (soft). The owner still sees it, marked, in their studio.
  removedAt        DateTime?
  removedById      String?
  removalReason    String?

  @@index([ownerId, status])
  @@index([status, visibility, publishedAt])
  @@index([genres], type: Gin)
  @@map("portfolio_item")
}

// ─────────────────────────────────────────────────────────────
// Feed
// ─────────────────────────────────────────────────────────────

enum PostType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  /// Shares a published portfolio item.
  SHOWCASE
}

model Post {
  id              String         @id @default(cuid())
  authorId        String
  author          User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type            PostType
  body            String?
  portfolioItemId String?
  portfolioItem   PortfolioItem? @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  editedAt        DateTime?
  /// Moderation removal (soft): hidden everywhere, kept for history and possible restore.
  removedAt       DateTime?
  removedById     String?
  removalReason   String?
  media           PostMedia[]
  likes           PostLike[]
  comments        Comment[]

  /// Feed pages are read newest-first with a (createdAt, id) cursor.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([portfolioItemId])
  @@map("post")
}

model PostMedia {
  postId   String
  post     Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  /// Unique: one asset belongs to one post.
  assetId  String     @unique
  asset    MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  position Int

  @@id([postId, assetId])
  @@map("post_media")
}

model PostLike {
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  /// One like per person per post.
  @@id([postId, userId])
  @@index([userId])
  @@map("post_like")
}

model Comment {
  id            String    @id @default(cuid())
  postId        String
  post          Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId      String
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body          String
  createdAt     DateTime  @default(now())
  removedAt     DateTime?
  removedById   String?
  removalReason String?

  @@index([postId, createdAt])
  @@map("comment")
}

// ─────────────────────────────────────────────────────────────
// Reports — stored now; the moderation queue arrives in Milestone 5.
// ─────────────────────────────────────────────────────────────

enum ReportTargetType {
  POST
  COMMENT
  PORTFOLIO_ITEM
  PROFILE
  COMMUNITY
  DISCUSSION
  DISCUSSION_COMMENT
  COMPETITION
  COMPETITION_ENTRY
  MESSAGE
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  SEXUAL_CONTENT
  VIOLENCE
  COPYRIGHT
  IMPERSONATION
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model Report {
  id           String           @id @default(cuid())
  reporterId   String
  reporter     User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   ReportTargetType
  targetId     String
  reason       ReportReason
  details      String?
  status       ReportStatus     @default(PENDING)
  /// Staff member handling it (MODERATOR or ADMIN).
  assigneeId   String?
  /// Escalated reports can only be resolved or dismissed by an ADMIN.
  escalated    Boolean          @default(false)
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt
  notes        ReportNote[]

  /// Reporting the same thing twice doesn't create duplicates.
  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([assigneeId, status])
  @@map("report")
}

/// Internal moderation notes. Never shown to the reporter or the reported user. Not editable.
model ReportNote {
  id        String   @id @default(cuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime @default(now())

  @@index([reportId, createdAt])
  @@map("report_note")
}

/// Append-only record of administrative actions. UPDATE/DELETE/TRUNCATE are blocked by a
/// database trigger (see migration). actorId is not a foreign key, so history survives deletions.
model AuditLog {
  id         String   @id @default(cuid())
  /// null for system actions (CLI, automatic suspension expiry).
  actorId    String?
  actorRole  String?
  /// e.g. "cli:admin:grant-initial", "system:suspension-expiry"
  actorLabel String?
  action     String
  targetType String
  targetId   String
  reason     String?
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

// ─────────────────────────────────────────────────────────────
// Relationships — two separate systems (CLAUDE.md §10).
// ─────────────────────────────────────────────────────────────

/// One-way, no approval needed. Self-follows are blocked by a CHECK constraint (migration SQL).
model Follow {
  followerId  String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follow")
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  /// Withdrawn by the requester while pending.
  CANCELLED
  /// An accepted connection that either person ended.
  REMOVED
}

/// Mutual, needs acceptance. At most one PENDING or ACCEPTED row per pair of people,
/// in either direction — enforced by a partial unique index (migration SQL).
model Connection {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      ConnectionStatus @default(PENDING)
  message     String?
  createdAt   DateTime         @default(now())
  respondedAt DateTime?
  updatedAt   DateTime         @updatedAt

  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("connection")
}

// ─────────────────────────────────────────────────────────────
// Reliability infrastructure (M0, ADR 0003)
// ─────────────────────────────────────────────────────────────

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

/// One row per (user, Idempotency-Key) for unsafe-to-retry writes. A repeat with the same
/// request replays the stored response; a different request with the same key is refused.
/// Rows expire after 24 h and are swept.
model IdempotencyKey {
  id             String            @id @default(cuid(2))
  userId         String
  key            String
  method         String
  path           String
  requestHash    String
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime          @default(now())
  expiresAt      DateTime

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_key")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

/// Transactional outbox: written in the same transaction as the change it describes, then
/// delivered by a worker with retries (notifications, emails, realtime fan-out).
model OutboxEvent {
  id          String       @id @default(cuid(2))
  topic       String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  lockedAt    DateTime?
  lastError   String?
  createdAt   DateTime     @default(now())
  processedAt DateTime?

  @@index([status, availableAt])
  @@map("outbox_event")
}

// ─────────────────────────────────────────────────────────────
// Opportunities (FR-34..37)
// ─────────────────────────────────────────────────────────────

enum OpportunityType {
  GIG
  AUDITION
  EVENT
  JOB
  COLLABORATION
}

enum OpportunityStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  SUBMITTED
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Opportunity {
  id           String                   @id @default(cuid(2))
  organiserId  String
  organiser    User                     @relation("OpportunityOrganiser", fields: [organiserId], references: [id], onDelete: Cascade)
  type         OpportunityType
  title        String
  description  String
  requirements String?
  location     String?
  remote       Boolean                  @default(false)
  deadline     DateTime
  status       OpportunityStatus        @default(DRAFT)
  publishedAt  DateTime?
  closedAt     DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  applications OpportunityApplication[]

  @@index([status, deadline])
  @@index([organiserId])
  @@map("opportunity")
}

/// One per (opportunity, applicant). Withdrawing keeps the row; re-applying before the deadline reopens it.
model OpportunityApplication {
  id            String            @id @default(cuid(2))
  opportunityId String
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  applicantId   String
  applicant     User              @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  message       String
  status        ApplicationStatus @default(SUBMITTED)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([opportunityId, applicantId])
  @@index([applicantId])
  @@map("opportunity_application")
}

// ─────────────────────────────────────────────────────────────
// Billing: catalogue and entitlements (Phase 2, ADR 0004). Orders/payments come in Phase 3.
// ─────────────────────────────────────────────────────────────

enum BillingProduct {
  CREATOR_PLUS
  PRO
  POST_BOOST
  PROFILE_SPOTLIGHT
  /// Automated tests only (Phase 3). Allowed only on testOnly catalogue rows (CHECK), never in
  /// the shared product list, so the admin API, seed and public catalogue can't reach it.
  TEST_ITEM
}

enum CatalogueOption {
  MONTHLY
  ANNUAL
  DAYS_3
  DAYS_7
  DAYS_14
}

/// Versioned price list: a change inserts a new row (never updates one). The row in force for a
/// (product, option) is the latest with effectiveFrom <= now. Whole XAF only.
model ServiceCatalogue {
  id            String          @id @default(cuid(2))
  product       BillingProduct
  option        CatalogueOption
  durationDays  Int
  priceXaf      Int
  /// Can be bought. Only products in SELLABLE_PRODUCTS (code) may be activated.
  active        Boolean         @default(false)
  effectiveFrom DateTime        @default(now())
  updatedById   String?
  reason        String?
  /// Created only by test code (refused when NODE_ENV=production). CHECK: testOnly <=> TEST_ITEM.
  testOnly      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  orders        Order[]

  @@unique([product, option, effectiveFrom])
  @@index([product, option, effectiveFrom])
  @@map("service_catalogue")
}

enum ProfileAccent {
  LIME
  GOLD
  VIOLET
  SKY
  MINT
}

enum SubscriptionPlan {
  CREATOR_PLUS
  PRO
}

enum EntitlementStatus {
  ACTIVE
  CANCELLED
  REFUNDED
}

/// One paid period. Entitlement = ACTIVE and periodStart <= now < periodEnd (computed at request time).
model Subscription {
  id          String            @id @default(cuid(2))
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan
  periodStart DateTime
  periodEnd   DateTime
  status      EntitlementStatus @default(ACTIVE)
  /// The member cancelled: no renewal reminders. Benefits continue until periodEnd (prepaid).
  cancelledAt DateTime?
  createdAt   DateTime          @default(now())

  @@index([userId, periodEnd])
  @@map("subscription")
}

enum PromotionTarget {
  POST
  PROFILE
}

/// A paid placement period for one post (Post Boost) or one profile (Spotlight). Never overlaps:
/// buying again extends from the current end.
model Promotion {
  id          String            @id @default(cuid(2))
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     BillingProduct
  targetType  PromotionTarget
  targetId    String
  periodStart DateTime
  periodEnd   DateTime
  status      EntitlementStatus @default(ACTIVE)
  /// Ended early by moderation or an admin (status CANCELLED), with the reason shown to the owner.
  endedAt     DateTime?
  endedReason String?
  endedById   String?
  createdAt   DateTime          @default(now())

  @@index([targetType, targetId, periodEnd])
  @@index([userId])
  @@map("promotion")
}

// ─────────────────────────────────────────────────────────────
// Payments lifecycle (Phase 3, ADR 0004, docs/payments-state-machine.md)
// ─────────────────────────────────────────────────────────────

enum PaymentMode {
  SANDBOX
  LIVE
}

/// See docs/payments-state-machine.md for every allowed transition.
enum OrderStatus {
  PENDING
  PROCESSING
  /// Payment verified with the provider; the benefit hasn't been granted yet (retried by the outbox).
  FULFILMENT_PENDING
  FULFILLED
  FAILED
  CANCELLED
  EXPIRED
  /// A payment we can't safely act on (late success, amount/currency mismatch, partial payment,
  /// refund made outside MuzikHub). Never fulfilled automatically; an admin decides.
  NEEDS_REVIEW
  REFUNDED
}

/// One purchase attempt. Price, product and duration are snapshots taken at creation.
model Order {
  id                    String           @id @default(cuid(2))
  /// Ours, sent to the provider: "mh_" + 128 random bits. No personal data.
  reference             String           @unique
  userId                String
  user                  User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  mode                  PaymentMode
  provider              String
  catalogueId           String
  catalogue             ServiceCatalogue @relation(fields: [catalogueId], references: [id], onDelete: Restrict)
  product               BillingProduct
  option                CatalogueOption
  durationDays          Int
  /// Promotions only: the post (Post Boost) or the buyer's own user id (Profile Spotlight).
  targetId              String?
  amountXaf             Int
  currency              String           @default("XAF")
  status                OrderStatus      @default(PENDING)
  statusReason          String?
  idempotencyKey        String
  requestHash           String
  checkoutUrl           String?
  providerTransactionId String?
  /// Database time at creation + our TTL (authoritative, independent of the provider's).
  expiresAt             DateTime
  paidAt                DateTime?
  fulfilledAt           DateTime?
  refundRequestedAt     DateTime?
  refundedAt            DateTime?
  refundReason          String?
  refundedById          String?
  /// Notch Pay keeps the original collection fee on refunds (Refunds → Limitations).
  providerFeeRefunded   Boolean          @default(false)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  events                OrderEvent[]
  fulfilments           Fulfilment[]

  @@unique([userId, idempotencyKey])
  @@index([status, createdAt])
  @@index([userId, status])
  @@map("payment_order")
}

/// Append-only history of every status change (who/what caused it).
model OrderEvent {
  id         String       @id @default(cuid(2))
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  trigger    String
  actorId    String?
  detail     String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
  @@map("payment_order_event")
}

/// The benefit granted for an order. Unique per (order, fulfiller): a repeat does nothing.
model Fulfilment {
  id              String   @id @default(cuid(2))
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  fulfiller       String
  /// "SUBSCRIPTION" | "PROMOTION" | null — the entitlement row a refund must mark REFUNDED.
  entitlementType String?
  entitlementId   String?
  createdAt       DateTime @default(now())

  @@unique([orderId, fulfiller])
  @@map("payment_fulfilment")
}

/// Authenticated provider webhooks, kept for de-duplication and audit (no customer personal
/// data, no raw body: only its SHA-256). Retention: 90 days (sweep in server.ts).
model WebhookEvent {
  id               String   @id @default(cuid(2))
  provider         String
  providerEventId  String
  type             String
  orderReference   String?
  matchedOrder     Boolean
  bodySha256       String
  signatureVariant String?
  receivedAt       DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([receivedAt])
  @@map("payment_webhook_event")
}

// ─────────────────────────────────────────────────────────────
// Notifications (in-app). Created only from real events, server-side (CLAUDE.md §15).
// ─────────────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid(2))
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// e.g. payment.succeeded, subscription.expiring, promotion.ended
  type      String
  title     String
  body      String
  /// In-app path to open (never an external URL).
  link      String?
  /// Makes "notify once" safe under retries (e.g. one expiry reminder per period).
  dedupeKey String?   @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notification")
}

// ─────────────────────────────────────────────────────────────
// Analytics: aggregated daily counters only (owner decision). No per-event rows are kept.
// ─────────────────────────────────────────────────────────────

enum AnalyticsEvent {
  PROFILE_VIEW
  PLAY
  LINK_CLICK
}

enum AnalyticsSubject {
  PROFILE
  PORTFOLIO_ITEM
  POST
  PROFILE_LINK
}

/// One counter per owner, UTC day, event and subject. This is the only analytics data kept long-term.
model AnalyticsDaily {
  ownerId     String
  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  day         DateTime         @db.Date
  event       AnalyticsEvent
  subjectType AnalyticsSubject
  subjectId   String
  count       Int              @default(0)

  @@id([ownerId, day, event, subjectType, subjectId])
  @@index([ownerId, day])
  @@map("analytics_daily")
}

/// De-duplication only: "this viewer already counted for this subject today". viewerHash is an
/// HMAC with a key that changes every day, so it can't be linked across days or reversed to a
/// person. Rows older than 2 days are deleted (server.ts sweep).
model AnalyticsSeen {
  day        DateTime       @db.Date
  event      AnalyticsEvent
  subjectId  String
  viewerHash String

  @@id([day, event, subjectId, viewerHash])
  @@map("analytics_seen")
}

// ─────────────────────────────────────────────────────────────
// Safety and preferences (platform milestone 1)
// ─────────────────────────────────────────────────────────────

/// A blocks B: B can't message, request collaboration, connect, follow or invite A (and vice versa
/// for messaging). Enforced server-side in every interaction service (PROF-006, MSG-003).
model UserBlock {
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_block")
}

/// Per-category in-app notification preference (MSG-006). Missing row = on. Payment, plan and
/// account-safety notices are not configurable.
enum NotificationCategory {
  MESSAGES
  COMMUNITIES
  COLLABORATION
  COMPETITIONS
  NETWORK
  PROMOTIONS
}

model NotificationSetting {
  userId   String
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category NotificationCategory
  inApp    Boolean              @default(true)

  @@id([userId, category])
  @@map("notification_setting")
}
