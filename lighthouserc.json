{
  "ci": {
    "collect": {
      "startServerCommand": "API_PROXY_TARGET=http://localhost:4100 npm run preview -w @muzikhub/web -- --port 4173 --strictPort",
      "startServerReadyPattern": "Local",
      "url": ["http://localhost:4173/", "http://localhost:4173/login", "http://localhost:4173/register"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "http://[^/]+/$",
          "assertions": {
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500,
                "aggregationMethod": "median-run"
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1,
                "aggregationMethod": "median-run"
              }
            ],
            "total-blocking-time": [
              "warn",
              {
                "maxNumericValue": 300,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:best-practices": [
              "warn",
              {
                "minScore": 0.9,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:seo": [
              "warn",
              {
                "minScore": 0.9,
                "aggregationMethod": "median-run"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "http://[^/]+/(login|register)$",
          "assertions": {
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 3400,
                "aggregationMethod": "median-run"
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1,
                "aggregationMethod": "median-run"
              }
            ],
            "total-blocking-time": [
              "warn",
              {
                "maxNumericValue": 300,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:best-practices": [
              "warn",
              {
                "minScore": 0.9,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:seo": [
              "warn",
              {
                "minScore": 0.9,
                "aggregationMethod": "median-run"
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
